{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "stramus",
  "description": "__MSG_extDescription__",
  "version": "1.3.0",
  "default_locale": "en",
  "homepage_url": "https://stramus.space/",
  "permissions": [
    "tabs",
    "history",
    "search",
    "favicon",
    "identity"
  ],
  "host_permissions": [
    "https://api.stramus.space/*"
  ],
  "minimum_chrome_version": "138",
  "oauth2": {
    "client_id": "18928481720-vbolufg5c53b7gch7okeuk4lt4kkrst2.apps.googleusercontent.com",
    "scopes": ["openid", "email"]
  },
  "icons": {
    "16": "logo-16.png",
    "32": "logo-32.png",
    "48": "logo-48.png",
    "128": "logo-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "logo-16.png",
      "32": "logo-32.png",
      "48": "logo-48.png",
      "128": "logo-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
