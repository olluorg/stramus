{
  "manifest_version": 3,
  "name": "stramus",
  "version": "0.1.0",
  "description": "Save and organize your open tabs into collections.",
  "permissions": ["tabs", "history", "search"],
  "minimum_chrome_version": "138",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "stramus — open new tab"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
